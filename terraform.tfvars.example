# ---------------------------------------------------------------------------------------------------------------------
# Enterprise Azure Landing Zone - Management Group Hierarchy Variables Example
# ---------------------------------------------------------------------------------------------------------------------

root_id   = "contoso"
root_name = "Contoso Enterprise Landing Zone"

# Optional: Override parent MG ID if not using Tenant Root Group
# parent_management_group_id = "/providers/Microsoft.Management/managementGroups/custom-parent-mg"

# Optional: Place existing Azure subscriptions under specific Management Groups
subscription_placement = {
  # management   = ["00000000-0000-0000-0000-000000000001"]
  # connectivity = ["00000000-0000-0000-0000-000000000002"]
  # identity     = ["00000000-0000-0000-0000-000000000003"]
  # corp         = ["00000000-0000-0000-0000-000000000004"]
  # online       = ["00000000-0000-0000-0000-000000000005"]
  # nonprod      = ["00000000-0000-0000-0000-000000000006"]
  # sandbox      = ["00000000-0000-0000-0000-000000000007"]
}

tags = {
  Environment  = "Production"
  ManagedBy    = "Terraform"
  Department   = "Cloud Engineering"
  Architecture = "Azure Cloud Adoption Framework (CAF)"
  CostCenter   = "CC-10492"
}
